# Example environment for the radar (copy to .env and fill in; never commit .env).
#
# .env is git-ignored (mode 600 recommended). The radar never starts servers
# and never performs cloud inference; all endpoints below are user-owned
# loopback/private-LAN services.

# FreeToken OpenAI-compatible endpoint for synthesis (PydanticAI only).
FREETOKEN_BASE_URL=http://192.168.0.166:1919/v1
# Model id served by the endpoint (skips the /models lookup when set).
FREETOKEN_MODEL=Qwen3.6-35B-A3B-NVFP4
# Local API key placeholder (sent only to the configured LAN endpoint).
FREETOKEN_API_KEY=freetoken-local
# Opt-in server-specific thinking-disable key (1/true/yes/on to enable).
FREETOKEN_DISABLE_THINKING=

# OpenAlex personal budget key (optional; keyless anonymous quota applies).
OPENALEX_API_KEY=

# Preferred CLEF/SystemOne screening endpoint (NOT launched by radar).
# If absent or screening fails, Qwen answers the SAME screening inputs
# through the existing FreeToken chat endpoint using PydanticAI.
CLEF_BASE_URL=
# CLEF model id (default clef-flash when unset but base URL configured).
CLEF_MODEL=clef-flash

# Qwen routing and synthesis both use FREETOKEN_BASE_URL/FREETOKEN_MODEL.
# Qwen does NOT need a native /v1/systemone endpoint. Routing responses use
# the same Pydantic SystemOne answer model, with prompted-estimate provenance.
